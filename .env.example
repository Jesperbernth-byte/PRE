# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Supabase (for Site Editor database)
VITE_SUPABASE_URL=https://xxx.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_key_here

# Admin Authentication
PRE_ADMIN_USERNAME=admin
PRE_ADMIN_PASSWORD=your_secure_password_here

# Secret for signing admin JWT tokens (any random string ≥ 32 chars).
# Generate one: openssl rand -base64 48
# REQUIRED — without this all admin API endpoints will return 500.
ADMIN_JWT_SECRET=replace_me_with_long_random_string

# Site URL (for deployment tracking - set to customer's domain when transferred)
PRE_SITE_URL=https://prentreprenoer.dk

# Email notifications for new leads (Resend.com)
# Sign up at resend.com, verify prentreprenoer.dk, paste API key here.
# Without this, leads still save to Supabase but no email goes to jeh@.
RESEND_API_KEY=
LEAD_NOTIFY_FROM=PR Entreprenøren <noreply@prentreprenoer.dk>
